# Configuración del LLM (cliente compatible con OpenAI: Gemini, OpenRouter, Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=tu-clave-aqui
LLM_MODEL=gpt-4o-mini

# Configuración de Whisper (transcripción)
WHISPER_MODEL=medium
WHISPER_COMPUTE=int8_float16
WHISPER_LANGUAGE=es

# Directorio de datos (videos, audio, transcripciones, clips)
DATA_DIR=./data

# Codificador de video preferido (h264_nvenc con fallback a libx264)
VIDEO_ENCODER=h264_nvenc
